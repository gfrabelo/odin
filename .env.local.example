# ── IA ────────────────────────────────────────────────────────────
# Chave da API Google Gemini. Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chave da API OpenAI para síntese de voz (TTS). Obtenha em https://platform.openai.com/
OPENAI_API_KEY=
# Voz padrão do Odin para síntese (opções: alloy, echo, fable, onyx, nova, shimmer). Padrão: onyx
OPENAI_TTS_VOICE=onyx

# Provedor principal de LLM (opções: gemini ou openai). Padrão: gemini
LLM_PROVIDER=gemini
# Modelo do Gemini usado no chat. Padrão: gemini-3.5-flash (rápido + agentic).
# Alternativas (modo profundo): gemini-2.5-pro, gemini-3.1-pro-preview, gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash
# Velocidade da fala (0.25–4.0). Padrão: 1.15 (mais fluido).
# OPENAI_TTS_SPEED=1.15

# Busca web da ferramenta `webSearch` (function calling). Chave da Tavily
# (https://app.tavily.com - free tier 1.000/mês). OPCIONAL: sem ela, o Odin
# usa um resultado mockado. Para trocar de provedor, edite webSearch em lib/ai/tools.ts.
# SEARCH_API_KEY=tvly-...

# ── Supabase (RAG: pgvector sobre o segundo cérebro) ──────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://zvcuahmxipijphqhyfox.supabase.co
# Service role key: uso SÓ no servidor (ingestão + retrieval). Nunca exponha
# no client. Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ── Ingestão (opcional) ───────────────────────────────────────────
# Caminho do vault Obsidian (padrão: ../segundo-cerebro).
# VAULT_PATH=../segundo-cerebro
# Pastas a indexar, separadas por vírgula (padrão seguro: só "wiki").
# A pasta it-lean-confidencial é SEMPRE excluída, independente disto.
# INGEST_DIRS=wiki

# ── Apify (Prospect Agent — scraping de leads) ───────────────────
# Token da API Apify para o Google Maps Scraper. Obtenha em
# https://console.apify.com → Integrations → API tokens.
# OPCIONAL: sem ele, o Researcher usa webSearch como fallback.
# APIFY_API_TOKEN=apify_api_...

# Copie este arquivo para `.env.local` e preencha. NÃO commite o `.env.local`.
